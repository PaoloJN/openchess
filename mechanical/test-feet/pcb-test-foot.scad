// OpenChess — PCB bench-test leg (no-hardware SNAP-FIT standoff)
// Lifts the matrix PCB 45 mm off the bench for testing. No screws.
// The peg is split by a + slot into 4 flexible prongs with barbs: push the
// board down over it, the prongs squeeze through the M3 hole (low force, so
// nothing snaps) and the barbs click over the top of the board to hold it.
// Pull up firmly / pinch the prongs to remove. Print all 4, no supports.
//
// NOTE: the ready-to-print STL is generated by make_snap_leg.py (trimesh).
// This .scad is the parametric reference — same numbers.

$fn = 96;

height    = 45.0;   // post height = PCB rest face
col_d     = 8.0;    // post diameter
pad_d     = 14.0;   // foot pad diameter
pad_h     = 2.0;    // foot pad thickness

shaft_d   = 3.0;    // peg shaft (slips through the Ø3.2 M3 hole)
board_gap = 1.8;    // shoulder -> barb underside (1.6 mm board + 0.2 play)
barb_d    = 3.8;    // barb catch dia (> hole -> holds board down)
tip_d     = 2.2;    // barb tip (< hole -> guides in / compresses)
slot_w    = 1.2;    // + slot width (prong gap)

barb_z    = height + board_gap;
peg_top   = barb_z + 2.7;
slot_root = height - 3.0;   // prongs hinge here

module pcb_test_leg() {
    difference() {
        union() {
            cylinder(h = pad_h, d = pad_d);                 // foot pad
            cylinder(h = height, d = col_d);                // post
            cylinder(h = barb_z, d = shaft_d);              // shaft
            translate([0, 0, barb_z])                       // barb
                cylinder(h = peg_top - barb_z, d1 = barb_d, d2 = tip_d);
        }
        for (a = [0, 90])                                   // + slot -> 4 prongs
            rotate([0, 0, a])
                translate([0, 0, (slot_root + peg_top) / 2 + 1])
                    cube([col_d + 4, slot_w, peg_top - slot_root + 2],
                         center = true);
    }
}

// 4 up on the plate
for (x = [0, 22], y = [0, 22])
    translate([x, y, 0]) pcb_test_leg();
